# ============================================================
# 思而行 · 环境变量示例（可选）
# 复制为 .env 后填写即可；也可以什么都不填，直接在网页「设置」里配置。
# 同名环境变量一旦设置，会作为默认值；网页设置里填写的值优先。
# ============================================================

# 端口（默认 3213）
PORT=3213

# AI 提供方：openai（任意 OpenAI 兼容接口，推荐）| opencode（本机已安装 opencode 时可选）
SIERXING_PROVIDER=openai

# ---- OpenAI 兼容接口示例（任选其一，取消注释并填写）----
# DeepSeek
# SIERXING_API_BASE=https://api.deepseek.com/v1
# SIERXING_MODEL=deepseek-chat

# 阿里云百炼（通义千问）
# SIERXING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# SIERXING_MODEL=qwen-plus
# SIERXING_VISION_MODEL=qwen-vl-max

# 月之暗面 Kimi
# SIERXING_API_BASE=https://api.moonshot.cn/v1
# SIERXING_MODEL=moonshot-v1-8k

# 智谱 GLM
# SIERXING_API_BASE=https://open.bigmodel.cn/api/paas/v4
# SIERXING_MODEL=glm-4-plus

# 硅基流动
# SIERXING_API_BASE=https://api.siliconflow.cn/v1
# SIERXING_MODEL=deepseek-ai/DeepSeek-V3

# OpenAI
# SIERXING_API_BASE=https://api.openai.com/v1
# SIERXING_MODEL=gpt-4o-mini

# 本地 Ollama（无需密钥）
# SIERXING_API_BASE=http://localhost:11434/v1
# SIERXING_API_KEY=ollama
# SIERXING_MODEL=qwen2.5:14b

# 密钥（按所用服务填写）
SIERXING_API_KEY=

# 视觉模型（可选：识别 JD 等图片用；留空则与文本模型相同）
SIERXING_VISION_MODEL=

# 单次 AI 请求超时（毫秒）
SIERXING_AI_TIMEOUT_MS=300000

# ---- 可选：LeetCode 刷题模块 ----
# VSCode LeetCode 插件登录态文件（用于拉取热题 100 与题面）
# 默认：~/.lc/leetcode.cn/user.json
# SIERXING_LC_USER_FILE=/path/to/user.json
# LeetCode 作答文件目录（默认 ~/Leetcode）
# SIERXING_PRACTICE_DIR=/path/to/leetcode-workspace
